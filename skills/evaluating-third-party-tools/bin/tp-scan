           '.woodpecker/', '.gitlab/')
MIN_EXT = {'.js', '.mjs', '.cjs', '.css'}

EXEC_EXT = {'.exe', '.dll', '.so', '.dylib', '.jar', '.war', '.ear', '.class', '.node', '.pyd',
            '.pyc', '.pyo', '.msi', '.scr', '.sys', '.apk', '.aab', '.ipa', '.dex', '.deb',
