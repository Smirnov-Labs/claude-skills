                'wasm', 'archive', 'blob', 'minified', 'endpoint']

# One command line: any character but a newline or a pipe, or a backslash-newline.
_W = r'(?:[^\n|]|\\\r?\n)'
_PIPE = r'(?<![\\|])\|(?!\|)'       # a pipe: not ||, and not \| (an escaped pipe in a shell or a regex)
_RUNNERS = (r'(?:(?:sudo|doas)(?:\s+-\S+)*\s+)?(?:(?:[\w./-]*/)?env(?:\s+-\S+)*(?:\s+\w+=\S*)*\s+)?'
            r'(?:[\w./-]*/)?(?:(?:ba|z|k|da|fi|tc)?sh|python[0-9.]*|perl|ruby|node|php'
            r'|(?i:pwsh|powershell(?:\.exe)?|iex|invoke-expression))\b')
_FETCH = r'(?:\b(?:curl|wget|fetch)|(?i:\b(?:iwr|irm|invoke-webrequest|invoke-restmethod)))[ \t]'   # with arguments
PIPE_RE = re.compile(
    _FETCH + _W + r'{0,400}(?:' + _PIPE + _W + r'{0,200}){0,3}?' + _PIPE + r'\s*' + _RUNNERS
    + r'|(?:\b(?:(?:ba|z|k)?sh|source)|(?<![\w.])\.)\s+<\(\s*(?:curl|wget)\b'
    + r'|\b(?:(?:ba|z|k|da)?sh|python[0-9.]*|node|perl|ruby|php)\s+-[ce]\s+["\']?\$\(\s*(?:curl|wget)\b'
    + r'|\b(?:curl|wget)[ \t][^\n&;|]{0,300}?(?:(?:https?|ftp)://|\$\{?\w)[^\n]{0,300}?(?:&&|;)[ \t]*'
      r'(?:(?:sudo|doas)[ \t]+(?:-\S+[ \t]+)*)?'
      r'(?:(?:ba|z|k|da)?sh[ \t]+\S|chmod[ \t]+\+x\b|\./\S)'
    + r'|(?i:\[scriptblock\]::create\s*\([^\n]{0,120}?(?:\biwr\b|\birm\b|invoke-webrequest|invoke-restmethod'
      r'|downloadstring))'
    + r'|(?i:\b(?:iex|invoke-expression)\b[^\n]{0,60}?(?:\biwr\b|\birm\b|invoke-webrequest'
      r'|invoke-restmethod|downloadstring|net\.webclient))')

_EXEC = (r'(?:\b(?:eval|exec|execSync|execFileSync|Function|runInThisContext|runInNewContext'
         r'|compileFunction|instance_eval|class_eval|module_eval|loadstring|create_function|system|popen'
         r'|shell_exec|passthru|proc_open|spawn|spawnSync|setTimeout|setInterval|pickle\.loads|cPickle\.loads'
         r'|dill\.loads)'
         r'|(?i:\b(?:iex|invoke-expression)))')
_DECODER = (r'(?:b64decode|b32decode|b16decode|a85decode|b85decode|decodebytes|decodestring'
            r'|decompress|unhexlify|fromhex|marshal\.loads|pickle\.loads|\batob\b|fromCharCode'
            r'|base64_decode|gzinflate|gzuncompress|str_rot13|decode64|decode_base64'
            r'|FromBase64String|rot13|unpack1?\s*\(\s*["\']m'
            r'|Buffer\.from\s*\([^)\n]{0,300}?["\'](?:base64|hex)["\']|urlopen'
            r'|requests\.(?:get|post)|httpx\.|\bfetch\s*\(|\baxios\b|XMLHttpRequest'
            r'|DownloadString|Invoke-WebRequest|\biwr\b|Net::HTTP|URI\.open'
            r'|https?\.get\s*\(|file_get_contents\s*\(\s*["\']https?:|curl_exec|HttpGet|\bchr\b)')
_TO_SHELL = (_PIPE + r'\s*(?:(?:sudo|doas)(?:\s+-\S+)*\s+)?(?:[\w./-]*/)?'
             r'(?:(?:ba|z|k|da)?sh|python[0-9.]*|perl|ruby|node)\b')
DECODE_RE = re.compile(
    _EXEC + r'\s*\([^;)]{0,300}?' + _DECODER
    + r'|\b(?:base64|openssl|xxd|gunzip|zcat|uudecode|gpg)\b' + _W + r'{0,300}' + _TO_SHELL
    + r'|\b(?:eval|(?:ba|z|k|da)?sh\s+-c)\s+["\']?\$\(\s*(?:curl|wget|fetch|base64'
      r'|(?:echo|printf)\s[^)\n]{0,300}?base64)'
    + r'|\beval\s+["\']?`\s*(?:curl|wget)'
    + r'|\b(?:ba|z|k)?sh\s*<<<\s*["\']?\$\([^)\n]{0,300}?base64'
    + r'|\beval\s*\(\s*function\s*\(\s*p\s*,\s*a\s*,\s*c\s*,\s*k\s*,\s*e\s*,\s*[dr]\s*\)'
    + r'|\beval\s+(?:pack|unpack|decode_base64|MIME::Base64::decode)\b'
    + r'|\b(?:printf|echo)\b[^\n|]{0,40}?(?:\\x[0-9a-fA-F]{2}|\\[0-7]{3}){4,}[^\n|]{0,200}' + _TO_SHELL
    + r'|(?i:\b(?:powershell|pwsh)(?:\.exe)?\b[^\n]{0,100}?\s-e[a-z]{0,13}\s+[A-Za-z0-9+/=]{16,})')

CRED_RE = re.compile(
    r'(?<![\w.-])\.ssh(?=[/\\"\'`\s,)]|$)|\bid_(?:rsa|dsa|ecdsa|ed25519)(?:_sk)?\b'
    r'|(?<![\w.-])\.aws(?=[/\\"\'`\s,)]|$)|\.config[/\\]gcloud\b|application_default_credentials\.json'
    r'|(?<![\w.-])\.azure[/\\]|(?<![\w.-])\.kube[/\\]config\b|(?<![\w.-])\.docker[/\\]config\.json'
    r'|(?<![\w.-])\.(?:netrc|git-credentials|vault-token|pgpass|gnupg|password-store)\b'
    r'|\.config[/\\]gh[/\\]hosts\.yml|\.terraform\.d[/\\]credentials|\.cargo[/\\]credentials'
    r'|\bsecurity\s+(?:find-(?:generic|internet)-password|dump-keychain)\b|Library[/\\]Keychains'
    r'|\blogin\.keychain|\bsecret-tool\s+(?:lookup|search)\b|\bCryptUnprotectData\b'
    r'|\bCred(?:Read|Enumerate)W?\b|\bvaultcmd\b|User Data[/\\](?:Default|Profile)'
    r'|Application Support[/\\](?:Google[/\\]Chrome|BraveSoftware|Microsoft Edge|Chromium|Firefox)'
    r'|\.config[/\\](?:google-chrome|chromium|BraveSoftware|microsoft-edge)\b'
    r'|\.mozilla[/\\]firefox|Firefox[/\\]Profiles|[/\\](?:Login Data|Local State|Web Data)\b'
    r'|\b(?:Cookies\.binarycookies|cookies\.sqlite|logins\.json|key4\.db|wallet\.dat|exodus\.wallet)\b'
    r'|nkbihfbeogaeaoehlefnkodbefgpgknn|(?<![\w.-])\.electrum[/\\]|\.config[/\\]solana[/\\]id\.json'
    r'|(?:~|\$HOME|\$\{HOME\}|homedir\(\)|expanduser\(|Path\.home\(\)|USERPROFILE)[^\n]{0,60}?'
    r'\.(?:npmrc|pypirc|bash_history|zsh_history|python_history|psql_history|mysql_history)\b'
    r'|\.local[/\\]share[/\\]keyrings|Local Storage[/\\]leveldb')

HIDDEN_RE = re.compile(r'[\u202a-\u202e\u2066-\u2069]|[\U000e0000-\U000e007f]{2,}'
                       r'|[\ufe00-\ufe0f\U000e0100-\U000e01ef]{4,}|[\u200b-\u200d\u2060\ufeff]{3,}'
                       r'|[\u115f\u1160\u3164\uffa0]')
# Any one of HIDDEN_RE's characters: a fast first check before the full pattern.
HIDDEN_ANY = re.compile('[' + ''.join(re.findall(r'\[([^\]]+)\]', HIDDEN_RE.pattern)) + ']')
OFFSCREEN_RE = re.compile(r'\S[ \t]{150,}\S')

TELEMETRY_RE = re.compile(
    r'(?<![A-Za-z0-9])(?:posthog|mixpanel|rudderstack|bugsnag|rollbar|logrocket|fullstory'
    r'|hotjar|statsig|newrelic|new_relic|datadog|dd-trace|honeycomb\.io|opentelemetry'
    r'|google-analytics|googletagmanager|plausible\.io|heapanalytics|segment\.(?:io|com)'
    r'|amplitude\.com|sentry\.io|sentry[_-]sdk|sentry\.init)(?![A-Za-z0-9])'
    r'|@(?:segment|amplitude|sentry)/|(?<![A-Za-z])telemetry(?![A-Za-z])'
    r'|\bamplitude\.(?:init|getInstance|track|logEvent|setUserId)\b|\bgtag\s*\(', re.I)

DOWNLOAD_RE = re.compile(
    r'(?<![\w.-])(?:curl|wget)\s+(?!-(?:-version|-help|V|h)\b)(?=-|["\']?\$|["\']?(?:https?|ftp)://)'
    r'|\burlretrieve\s*\(|\bdownload_file\s*\(|\bDownloadFile(?:Async)?\s*\(|\bDownloadString\s*\('
    r'|(?i:\binvoke-webrequest\b|\bstart-bitstransfer\b|\bcertutil(?:\.exe)?\s+-urlcache\b'
    r'|\bbitsadmin(?:\.exe)?\s+/transfer\b)|\biwr\s'
    r'|\bhf_hub_download\s*\(|\bsnapshot_download\s*\(|\btorch\.hub\.load\s*\('
    r'|\bprebuild-install\b|\bnode-pre-gyp\b|\bgit\s+clone\s')

URL_RE = re.compile(r'\b(?:https?|wss?|ftp)://(?:[^\s/@"\'<>]*@)?'
                    r'((?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,62})?\.)+[A-Za-z]{2,63}'
                    r'|\d{1,3}(?:\.\d{1,3}){3})(?![\w-])')
QUIET_HOST = re.compile(
    r'(?:^|\.)(?:example(?:\.(?:com|org|net|edu))?|localhost|test|invalid|local|internal|lan'
    r'|home\.arpa|localdomain|w3\.org|xmlsoap\.org|json-schema\.org|purl\.org|schema\.org'
    r'|schemas\.microsoft\.com|schemas\.android\.com|openxmlformats\.org|ns\.adobe\.com'
    r'|apache\.org|opensource\.org|gnu\.org|fsf\.org|creativecommons\.org|spdx\.org'
    r'|mozilla\.org|yaml\.org|xml\.org|oasis-open\.org|ietf\.org|rfc-editor\.org|unicode\.org'
    r'|npmjs\.org|yarnpkg\.com|npmjs\.com|pypi\.org|pythonhosted\.org|crates\.io|golang\.org'
    r'|rubygems\.org|maven\.org|gradle\.org|nuget\.org|packagist\.org|hex\.pm|pub\.dev'
    r'|cocoapods\.org|opencollective\.com|tidelift\.com|patreon\.com|ko-fi\.com|buymeacoffee\.com'
    r'|liberapay\.com|paypal\.me|polar\.sh)$', re.I)
# Package sources that lockfiles name all the time; any other host in a lockfile is unusual.
LOCK_HOST = re.compile(r'(?:^|\.)(?:github\.com|githubusercontent\.com|gitlab\.com|bitbucket\.org'
                       r'|npmmirror\.com|yarnpkg\.com|npmjs\.org)$', re.I)
EXFIL_HOST = re.compile(
    r'(?:^|\.)(?:discord(?:app)?\.com|telegram\.org|pastebin\.com|paste\.ee|hastebin\.com'
    r'|ngrok(?:-free)?\.(?:io|app|dev)|webhook\.site|requestbin\.\w+|pipedream\.net'
    r'|interact\.sh|oast\.(?:fun|live|site|online|pro|me)|burpcollaborator\.net'
    r'|trycloudflare\.com|serveo\.net|localtunnel\.me|loca\.lt|transfer\.sh|0x0\.st|file\.io'
    r'|gofile\.io|bit\.ly|tinyurl\.com|is\.gd|cutt\.ly|rb\.gy)$', re.I)

B64_RUN = re.compile(r'(?<![A-Za-z0-9+/_-])[A-Za-z0-9+/_-]{%d,}={0,2}' % ENCODED_MIN)
ESC_RUN = re.compile(r'(?<!\\x[0-9a-fA-F]{2})(?:\\x[0-9a-fA-F]{2}){%d,}' % (ENCODED_MIN // 4))
DATA_URI = re.compile(r'data:(?:image|font|audio|video|application/(?:x-)?font[\w.+-]*)'
                      r'(?:/[\w.+-]+)?;base64,$', re.I)
COMMENT = re.compile(r'[ \t]*(?:#(?![!\[])(?![ \t]*(?:define|include|if|ifdef|ifndef|elif|else|endif|pragma'
                     r'|undef|error|warning|import|region|endregion|line)\b)|//|/\*|\*|<!--|rem\s|::)', re.I)
UNSAFE = re.compile('[\x00-\x1f\x7f-\x9f\u00ad\u061c\u115f\u1160\u180e\u200b-\u200f'
                    '\u2028-\u202e\u2060-\u206f\u3164\ufe00-\ufe0f\ufeff\uffa0\ufff9-\ufffb'
                    '\U000e0000-\U000e007f\U000e0100-\U000e01ef]')

MEDIA_MAGIC = (b'\x89PNG', b'\xff\xd8\xff', b'GIF8', b'wOFF', b'wOF2', b'\x00\x01\x00\x00',
               b'OTTO', b'%PDF', b'ID3', b'OggS', b'fLaC', b'RIFF', b'<svg', b'<?xml', b'\x1aE\xdf\xa3')
PACKED_MAGIC = (b'\x7fELF', b'MZ', b'\xfe\xed\xfa', b'\xce\xfa\xed\xfe', b'\xcf\xfa\xed\xfe',
                b'\xca\xfe\xba\xbe', b'\x00asm', b'PK\x03\x04', b'\x1f\x8b', b'7z\xbc\xaf',
                b'\xfd7zXZ', b'BZh', b'\x28\xb5\x2f\xfd', b'Rar!')
ARCHIVE_MAGIC = (b'PK\x03\x04', b'PK\x05\x06', b'\x1f\x8b', b'BZh', b'\xfd7zXZ\x00',
                 b'7z\xbc\xaf\x27\x1c', b'Rar!', b'\x28\xb5\x2f\xfd', b'MSCF')
DATA_MAGIC = MEDIA_MAGIC + (b'SQLite format 3\x00', b'PAR1', b'\x93NUMPY', b'\x89HDF',
                            b'GGUF', b'\x00\x00\x01\x00', b'II*\x00', b'MM\x00*', b'8BPS',
                            b'BM', b'\xd0\xcf\x11\xe0')

PYPROJECT_RE = re.compile(       # run on toml_keys() text: keys unquoted, dotted or in [sections]
    r'^[ \t]*(?:build-system\.)?backend-path[ \t]*='
    r'|^[ \t]*\[?[^\n=\]]*\bhooks\.custom\b'
    r'|^[ \t]*\[?[ \t]*tool\.setuptools\.cmdclass\b|^[ \t]*cmdclass[ \t]*='
    r'|^[ \t]*\[?[ \t]*tool\.poetry\.build\b'
    r'|^[ \t]*(?:tool\.poetry\.)?build[ \t]*=[ \t]*(?:["\'][^"\'\n]+\.py["\']|\{[^}\n]*\bscript\b)'
    r'|^[ \t]*(?:tool\.pdm\.build\.)?custom-hook[ \t]*=', re.M)
GIT_CMD_KEY = re.compile(
    r'(?:core\.(?:fsmonitor|hookspath|pager|editor|sshcommand|askpass|gitproxy|alternaterefscommand)'
    r'|diff\.external|diff\..+\.(?:textconv|command)|merge\..+\.driver|filter\..+\.(?:clean|smudge|process)'
    r'|credential(?:\..+)?\.helper|gpg(?:\..+)?\.program|sequence\.editor|pager\..+'
    r'|uploadpack\.packobjectshook|include\.path|includeif\..+\.path'
