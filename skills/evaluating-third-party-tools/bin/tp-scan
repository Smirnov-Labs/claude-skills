             'bun.lock', 'poetry.lock', 'pipfile.lock', 'uv.lock', 'pdm.lock', 'cargo.lock',
             'go.sum', 'gemfile.lock', 'composer.lock', 'mix.lock', 'pubspec.lock',
             'podfile.lock', 'packages.lock.json', 'flake.lock', 'deno.lock', 'gradle.lockfile'}
CI_FILES = {'.gitlab-ci.yml', '.travis.yml', 'azure-pipelines.yml', 'bitbucket-pipelines.yml',
            'jenkinsfile', '.drone.yml', 'appveyor.yml', '.appveyor.yml', 'cloudbuild.yaml',
            'cloudbuild.yml', '.cirrus.yml', 'codemagic.yaml', '.woodpecker.yml'}
