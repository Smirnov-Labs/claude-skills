             'docs', 'target', 'release', 'coverage', '.next', '.nuxt', '.output'}
DOC_EXT = {'.md', '.markdown', '.mdx', '.rst', '.txt', '.adoc', '.asciidoc', '.org', '.textile', '.html', '.htm'}
DOC_NAMES = {'.gitignore', '.dockerignore', '.npmignore', '.eslintignore', '.prettierignore',
             '.gitattributes', '.editorconfig', '.mailmap', '.gitmodules', 'codeowners'}
DOC_STEM = re.compile(r'(?:readme|licen[cs]e|copying|notice|changelog|changes|history|news|'
                      r'authors|contributors|install|todo|unlicense)(?:[-_.].*)?$')
CONFIG_EXT = {'.json', '.jsonc', '.json5', '.yaml', '.yml', '.toml', '.ini', '.cfg', '.conf',
              '.xml', '.plist', '.properties', '.env', '.csv', '.tsv', '.svg', '.lock'}
